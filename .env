# ─── App ───
APP_ENV=production
SECRET_KEY=change-this-to-a-random-64-char-string
DEBUG=False

# ─── Database ───
# SQLite (dev):   sqlite:///platform.db
# Postgres (prod): postgresql://user:pass@localhost:5432/tgplatform
DATABASE_URL=sqlite:///platform.db

# ─── Telegram API ───
API_ID=28438619
API_HASH=5a9eaa827867f3a4b8e2341d736e636e
# ─── Admin ───
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!Strong123

# ─── Session Encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ───
SESSION_ENCRYPTION_KEY=

# ─── SocketIO Message Queue (required for multi-process: web + worker) ───
# Leave empty for single-process dev mode.
# For production: redis://localhost:6379/0
SOCKETIO_MESSAGE_QUEUE=

# ─── Rate Limits ───
DEFAULT_DAILY_LIMIT=50
CAMPAIGN_SEND_DELAY=2
CAMPAIGN_BATCH_SIZE=50
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=2.0
REPLY_POLL_INTERVAL_SECONDS=30

# ─── Security ───
SESSION_COOKIE_SECURE=True
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
