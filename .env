# ─── Core ───
SECRET_KEY=change-this-to-a-random-50-char-string
APP_ENV=development
DEBUG=True

# ─── Database ───
DATABASE_URL=sqlite:///platform.db   # will be created in the project root

# ─── Telegram API ───
API_ID=28438619
API_HASH=5a9eaa827867f3a4b8e2341d736e636e

# ─── Admin ───
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@Strong123

# ─── Security ───
TOTP_ISSUER=TelegramBotPlatform
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME=86400

# ─── Rate Limiting ───
DEFAULT_DAILY_LIMIT=50
RATE_LIMIT_DEFAULT=200 per minute

# ─── Campaign ───
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=2.0
CAMPAIGN_SEND_DELAY=2
CAMPAIGN_BATCH_SIZE=50

# ─── Reply Polling ───
REPLY_POLL_INTERVAL_SECONDS=30

# ─── Logging ───
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ─── SocketIO ───
SOCKETIO_ASYNC_MODE=threading